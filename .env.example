# Obligatoria: clave de Google Cloud con Geocoding API y Places API (New) habilitadas.
GOOGLE_MAPS_API_KEY=

# Opcionales (valores por defecto entre paréntesis)
PORT=8080
GOOGLE_MAPS_LANGUAGE=es
GOOGLE_MAPS_REGION=CO
GOOGLE_HTTP_TIMEOUT=10
CACHE_TTL_SECONDS=3600
CACHE_CLEANUP_SECONDS=600
MAX_PAGES=3
GRID_MAX_DEPTH=3
SEARCH_WORKERS=4

# Firebase Admin (Auth + Firestore). No subir el JSON al repo.
FIREBASE_CREDENTIALS_FILE=sistecontact-firebase-adminsdk-fbsvc-8adb9b6483.json

# Google Calendar OAuth (opcionales; sin ellos la UI muestra "no configurado").
# Crear OAuth Client ID tipo "Aplicación web" en Google Cloud Console.
# Authorized redirect URI debe coincidir con GOOGLE_OAUTH_REDIRECT_URL.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://apisistecontact.nodefex.com/api/integrations/google-calendar/callback
# Opcional; si vacío se usa el client secret para firmar el state.
GOOGLE_OAUTH_STATE_SECRET=
FRONTEND_ORIGIN=https://sistecontact.nodefex.com
